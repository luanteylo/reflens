# RefLens Configuration

# AI Providers (user provides their own keys)
REFLENS_ANTHROPIC_API_KEY=
REFLENS_OPENAI_API_KEY=
REFLENS_OPENAI_BASE_URL=             # custom base URL for OpenAI-compatible APIs

# AI Settings
REFLENS_AI_PROVIDER=ollama            # default provider: claude, openai, or ollama
REFLENS_AI_MODEL=mistral              # default model
REFLENS_AI_MODELS=ollama/mistral,ollama/llama3.1  # available models in UI
REFLENS_EMBEDDING_MODEL=all-MiniLM-L6-v2  # sentence-transformers model

# Ollama (free, local AI - install from https://ollama.com)
# Just run: ollama pull mistral && ollama pull llama3.1
# No API key needed, runs on localhost:11434
# To add cloud models: REFLENS_AI_MODELS=ollama/mistral,claude/claude-sonnet-4-6

# Database
REFLENS_DATABASE_URL=sqlite:///reflens.db   # or postgresql://user:pass@host/reflens

# GROBID
REFLENS_GROBID_URL=http://localhost:8070    # GROBID server URL

# Storage
REFLENS_STORAGE_PATH=./storage              # where uploaded PDFs are stored
REFLENS_CHROMA_PATH=./chroma_data           # where ChromaDB stores vectors

# Server
REFLENS_HOST=127.0.0.1
REFLENS_PORT=8000
