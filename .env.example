# RefLens Configuration

# AI Providers (user provides their own keys)
REFLENS_ANTHROPIC_API_KEY=
REFLENS_OPENAI_API_KEY=

# AI Settings
REFLENS_AI_PROVIDER=claude           # claude or openai
REFLENS_AI_MODEL=claude-sonnet-4-6  # model to use for summarization/tagging
REFLENS_EMBEDDING_MODEL=all-MiniLM-L6-v2  # sentence-transformers model

# Database
REFLENS_DATABASE_URL=sqlite:///reflens.db   # or postgresql://user:pass@host/reflens

# GROBID
REFLENS_GROBID_URL=http://localhost:8070    # GROBID server URL

# Storage
REFLENS_STORAGE_PATH=./storage              # where uploaded PDFs are stored
REFLENS_CHROMA_PATH=./chroma_data           # where ChromaDB stores vectors

# Server
REFLENS_HOST=127.0.0.1
REFLENS_PORT=8000
